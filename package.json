{
  "name": "translytix-integrated",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "nodemon --watch server --ext mjs --exec \"node server/index.mjs\"",
    "dev:client": "vite --host",
    "build": "vite build",
    "start": "node server/index.mjs",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.10.3",
    "zustand": "^4.5.2",
    "framer-motion": "^11.2.0",
    "classnames": "^2.5.1",
    "react-map-gl": "^7.1.5",
    "mapbox-gl": "^2.15.0",
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.4.5",
    "vite": "^5.3.3",
    "@vitejs/plugin-react": "^4.2.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.0"
  }
}